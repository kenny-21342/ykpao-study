generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bgImage       String?
  password      String?
  role          String    @default("student") // student | teacher | admin
  banned        Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  onboardedAt   DateTime? // null = hasn't completed the welcome wizard yet
  unlocks       String[]  @default([]) // easter-egg unlocks, e.g. ["competition"]
  // Orphaned: the BetterNotes sync layer that minted and read this was
  // removed. Kept only so no migration drops a column that still holds data;
  // dropping it (and the index below) is the owner's call.
  syncToken     String?

  accounts                Account[]
  sessions                Session[]
  courses                 UserCourse[]
  notes                   Note[]
  questionAttempts        QuestionAttempt[]
  bookmarks               Bookmark[]
  pastPaperBookmarks      PastPaperBookmark[]
  bankQuestionBookmarks   BankQuestionBookmark[]
  bankQuestionAttempts    BankQuestionAttempt[]
  studySessions           StudySession[]
  sharedNotes             SharedNote[]
  noteComments            NoteComment[]
  noteRatings             NoteRating[]
  followers               Follow[]                @relation("Following")
  following               Follow[]                @relation("Followers")
  notebooks               Notebook[]
  pastPaperAttempts       PastPaperAttempt[]
  questionScratchpads     QuestionScratchpad[]
  mockExams               MockExam[]
  threads                 DiscussionThread[]
  posts                   DiscussionPost[]
  discussionVotes         DiscussionVote[]
  discussionFlagsGiven    DiscussionFlag[]        @relation("FlagReporter")
  discussionFlagsResolved DiscussionFlag[]        @relation("FlagResolver")
  usageRecords            UsageRecord[]
  notifications           Notification[]
  sentNotifications       Notification[]          @relation("NotificationsFrom")
  schoolResources         SchoolResource[]
  announcements           Announcement[]
  dailyChallengeAttempts  DailyChallengeAttempt[]
  noteCollaborations      NoteCollaborator[]
  cloudDocuments          CloudDocument[]
  learningProfile         LearningProfile?
  studyTasks              StudyTask[]
  reviewItems             ReviewItem[]
  pageCollaborations      PageCollaborator[]
  pageComments            PageComment[]
  pagePresences           PagePresence[]
  pageAwareness           PageAwareness[]
  pageSnapshots           PageSnapshot[]
  aiConversations         AIConversation[]
  aiProposals             AIActionProposal[]
  ragDocuments            RagDocument[]
  aiCredential            UserAiCredential?
  pageDrawings            PageDrawing[]

  // Orphaned alongside syncToken above; nothing queries this index any more.
  @@index([syncToken])
  @@map("users")
}

/// Bring-your-own-key AI credentials for one user.
///
/// The platform no longer pays for students' AI usage, so every AI feature
/// resolves a credential here first. A row can exist for either of two
/// independent reasons, which is why almost every column is nullable:
///
///  1. The student saved their own key/endpoint/models (`encryptedApiKey` set).
///  2. An admin granted them the shared server key (`sharedKeyAccess` true).
///
/// `encryptedApiKey` is an AES-256-GCM envelope from lib/credential-crypto.ts,
/// never plaintext. `keyHint` is the last four characters, the only part ever
/// sent to a client.
model UserAiCredential {
  id     String @id @default(cuid())
  userId String @unique

  /// AES-256-GCM envelope ("v1.<iv>.<tag>.<ciphertext>"). Never plaintext.
  encryptedApiKey String?
  /// Last four characters of the key, for display only.
  keyHint         String?
  /// OpenAI-compatible base URL, e.g. "https://api.deepseek.com/v1".
  baseUrl         String?
  /// Model used for chat, grading, hints, exam generation.
  textModel       String?
  /// Multimodal model used for handwriting OCR. Optional: text-only setups are
  /// supported, with vision features explicitly reported as unavailable.
  visionModel     String?

  /// Admin-granted fallback to the owner's server key. Costs the owner money,
  /// so this path keeps the monthly spend cap.
  sharedKeyAccess    Boolean   @default(false)
  sharedKeyGrantedBy String?
  sharedKeyGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sharedKeyAccess])
  @@map("user_ai_credentials")
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  title     String
  mode      String   @default("explain")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages  AIMessage[]
  proposals AIActionProposal[]

  @@index([userId, archived, updatedAt])
  @@index([courseId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  sources        Json?
  actionType     String?
  actionData     Json?
  intent         String?
  corpusCoverage Json?
  proposalId     String?  @unique
  createdAt      DateTime @default(now())

  conversation AIConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposal     AIActionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// Per-request AI usage tracking (for the Usage & API Credits page)
model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  feature   String // "ai-chat" | "mock-exam-generate" | "mock-exam-grade" | "practice-grade"
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  cost      Float    @default(0) // estimated cost in USD
  model     String   @default("deepseek-chat")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_records")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Course {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  subject        String
  level          String
  description    String?
  catalogManaged Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            UserCourse[]
  curriculumScopes CourseCurriculumScope[]
  conversations    AIConversation[]
  questions        Question[]
  notes            Note[]
  notebooks        Notebook[]

  @@map("courses")
}

model UserCourse {
  id                     String    @id @default(cuid())
  userId                 String
  courseId               String
  targetGrade            String?
  examDate               DateTime?
  currentLevel           String?
  recentResult           String?
  personalizationEnabled Boolean   @default(true)
  enrolledAt             DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("user_courses")
}

// Canonical bridge from a student-facing course to one or more curriculum
// slices used by RAG and the past-paper corpus. Course.code is an internal
// catalog identifier and must never be treated as a syllabus code.
model CourseCurriculumScope {
  id            String @id @default(cuid())
  courseId      String
  board         String
  qualification String
  level         String
  subjectCode   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, board, qualification, level, subjectCode])
  @@index([subjectCode])
  @@index([board, qualification, level, subjectCode])
  @@map("course_curriculum_scopes")
}

model Question {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  content      String
  questionType String
  difficulty   String
  year         Int?
  paperId      String?
  pageNumber   Int?
  marks        Int?
  topics       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts  QuestionAttempt[]
  bookmarks Bookmark[]

  @@map("questions")
}

// Past-paper bank (CAIE questions migrated from SQLite papers.db).
// doc_type distinguishes question papers ("qp") from markschemes ("ms").
model Subject {
  id   Int    @id @default(autoincrement())
  code String @unique // CAIE syllabus code ("0625") or IB slug ("ib-biology")
  name String

  // Browse taxonomy for the past paper browser.
  board         String @default("CAIE") // CAIE | IB (later AQA | OCR | Edexcel)
  qualification String @default("") // IGCSE | A Level | Diploma Programme

  papers      PastPaper[]
  discussions DiscussionThread[]

  @@index([board, qualification])
  @@map("subjects")
}

model PastPaper {
  id          Int      @id @default(autoincrement())
  subjectId   Int
  year        Int
  session     String // CAIE: s | w | m    IB: may | nov
  paperNumber Int
  variant     Int      @default(0)
  docType     String // qp | ms | in | rb | qb | tb | cs
  filename    String
  filepath    String   @unique // relative to pdf_extraction/; locates the file on disk
  fileHash    String?
  totalMarks  Int      @default(0)
  insertText  String   @default("")
  processedAt String?
  createdAt   DateTime @default(now())

  // Browse metadata. IB splits a sitting by level and timezone, so those are
  // part of a paper's identity there; both stay empty for CAIE.
  level     String @default("") // HL | SL | HLSL
  timezone  String @default("") // TZ1 | TZ2 | TZ3
  paperCode String @default("") // raw token, e.g. "12" or "1A"
  pageCount Int?
  sizeBytes Int?

  subject   Subject             @relation(fields: [subjectId], references: [id])
  questions PastPaperQuestion[]

  @@index([subjectId])
  @@index([year])
  @@index([subjectId, year, session, paperNumber, variant, docType])
  @@index([subjectId, year, session])
  @@index([filename])
  @@map("past_papers")
}

model PastPaperQuestion {
  id         Int    @id
  paperId    Int
  number     Int
  part       String @default("")
  subPart    String @default("")
  content    String
  latex      String @default("")
  marks      Int    @default(0)
  hasDiagram Int    @default(0)
  diagramRef String @default("")
  ordering   Int    @default(0)
  docType    String @default("qp") // qp | ms — distinguishes question from mark-scheme row
  topic      String @default("General") // sub-subject label, e.g. "Mechanics", "Algebra"

  paper                  PastPaper               @relation(fields: [paperId], references: [id])
  images                 QuestionImage[]
  attempts               PastPaperAttempt[]
  mockExamItems          MockExamItem[]
  scratchpads            QuestionScratchpad[]
  bookmarks              PastPaperBookmark[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  studyTasks             StudyTask[]
  reviewItems            ReviewItem[]

  @@index([paperId])
  @@index([number, part, subPart])
  @@index([docType])
  @@index([topic])
  @@map("past_paper_questions")
}

// A student's planning preferences. Progress and mastery are derived from
// attempt history rather than copied into this profile.
model LearningProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  examDate           DateTime?
  weeklyStudyMinutes Int       @default(300)
  targetGrade        String    @default("A")
  board              String?
  qualification      String?
  level              String?
  subjectCode        String?
  currentLevel       String?
  recentResult       String?
  availability       Json      @default("{}") // weekday (0-6) -> available minutes
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_profiles")
}

// A concrete item on the personal study plan. `source` distinguishes manual
// tasks from generated recommendations so future plans can be refreshed.
model StudyTask {
  id              String    @id @default(cuid())
  userId          String
  questionId      Int?
  // A task can point at either corpus, or at neither -- a mock-exam task and a
  // hand-written one carry no question. Two nullable columns rather than one,
  // because the corpora are separate tables and a foreign key can only point
  // at one of them; the same constraint that gives ReviewItem its pair.
  bankQuestionId  Int?
  title           String
  subject         String
  topic           String
  taskType        String    @default("practice") // practice | review | notes | mock-exam
  source          String    @default("manual") // manual | auto-plan | mock-exam
  dueAt           DateTime
  durationMinutes Int       @default(30)
  status          String    @default("pending") // pending | completed | skipped
  completedAt     DateTime?
  sourceRef       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     PastPaperQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  bankQuestion BankQuestion?      @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  @@index([userId, dueAt])
  @@index([userId, status])
  @@map("study_tasks")
}

// Normalized searchable representation of every authorized platform source.
// The source row remains authoritative; this index is disposable and can be
// refreshed incrementally after extraction or an edit.
model RagDocument {
  id              String    @id @default(cuid())
  documentKey     String    @unique
  sourceType      String
  sourceRecordId  String
  ownerId         String?
  title           String
  route           String?
  board           String?
  qualification   String?
  level           String?
  subjectCode     String?
  topic           String?
  year            Int?
  session         String?
  paper           String?
  documentType    String
  visibility      String    @default("private") // private | collaborator | shared | platform
  accessUserIds   String[]  @default([])
  contentHash     String
  extractionState String    @default("ready") // extracting | partial | ready
  metadata        Json      @default("{}")
  extractedAt     DateTime?
  indexedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner  User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks RagChunk[]

  @@index([sourceType, sourceRecordId])
  @@index([ownerId, visibility])
  @@index([board, qualification, level, subjectCode])
  @@index([year, documentType])
  @@map("rag_documents")
}

model RagChunk {
  id          String   @id @default(cuid())
  documentId  String
  ordinal     Int
  content     String
  contentHash String
  indexedAt   DateTime @default(now())

  document RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("rag_chunks")
}

// A materialized coverage statement for a board/qualification slice. It lets
// the assistant say exactly what is indexed without implying full coverage.
model RagCorpusManifest {
  id               String    @id @default(cuid())
  board            String    @default("")
  qualification    String    @default("")
  level            String    @default("")
  subjectCode      String    @default("")
  year             Int       @default(0)
  documentType     String    @default("")
  extractionState  String    @default("partial")
  questionCount    Int       @default(0)
  markSchemeCount  Int       @default(0)
  resourceCount    Int       @default(0)
  noteCount        Int       @default(0)
  availableYears   Int[]     @default([])
  availablePapers  String[]  @default([])
  lastExtractionAt DateTime?
  lastIndexingAt   DateTime?
  failures         Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([board, qualification, level, subjectCode, year, documentType])
  @@index([board, qualification, level, subjectCode])
  @@map("rag_corpus_manifests")
}

// All AI-generated writes go through this lifecycle. A draft is editable and
// harmless; only confirmation applies its validated payload atomically.
model AIActionProposal {
  id             String    @id @default(cuid())
  ownerId        String
  conversationId String?
  actionType     String
  payload        Json
  status         String    @default("draft") // draft | confirmed | cancelled | expired | applied
  idempotencyKey String    @unique
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  appliedAt      DateTime?
  appliedResult  Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      AIMessage?

  @@index([ownerId, status, expiresAt])
  @@index([conversationId])
  @@map("ai_action_proposals")
}

// A mistake or manually-created card in the spaced-repetition queue. Review
// scheduling uses a compact SM-2-style interval/ease calculation.
// A spaced-repetition card raised from a question got wrong.
//
// `questionId` and `bankQuestionId` are the same two-corpus pair carried by
// MockExamItem and DailyChallengeAttempt, and for the same reason: a foreign
// key can only point at one question table. A card raised by hand has neither,
// which is why there is no CHECK requiring exactly one here -- `prompt` and
// `answer` stand on their own.
//
// The bank reference matters for more than provenance. A crop-first question's
// mark scheme is often an image with no text at all (47,844 of them), so the
// card carries the id and the API resolves the strips to render on the back.
model ReviewItem {
  id             String    @id @default(cuid())
  userId         String
  questionId     Int?
  bankQuestionId Int?
  prompt         String
  answer         String
  subject        String
  topic          String
  status         String    @default("active") // active | mastered | archived
  nextReviewAt   DateTime  @default(now())
  intervalDays   Int       @default(0)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     PastPaperQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  bankQuestion BankQuestion?      @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  // One card per user per bank question, so a repeated mistake refreshes the
  // card rather than stacking duplicates -- the same guarantee the legacy pair
  // gives. Postgres treats NULLs as distinct, so hand-made cards (both ids
  // null) are unaffected by either constraint.
  @@unique([userId, bankQuestionId])
  @@index([userId, status, nextReviewAt])
  @@map("review_items")
}

// Linked figure/diagram for a question (coordinate-matched during extraction)
model QuestionImage {
  id         Int    @id @default(autoincrement())
  questionId Int
  imagePath  String // relative to extracted_images/
  pageNumber Int?
  bboxX0     Float?
  bboxY0     Float?
  bboxX1     Float?
  bboxY1     Float?

  question PastPaperQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_images")
}

model PastPaperAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      Int
  answer          String
  score           Float?
  maxScore        Int?
  isCorrect       Boolean?
  strengths       String[]
  weaknesses      String[]
  explanation     String?
  modelAnswer     String?
  gradingStatus   String   @default("official") // official | provisional | ungraded
  gradingSourceId Int?
  timeSpent       Int?
  answerImageUrl  String? // optional photo/screenshot of handwritten working
  gradingMode     String   @default("text") // text | ocr-text | vision -- which path actually graded this attempt
  attemptedAt     DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question PastPaperQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("past_paper_attempts")
}

// AI-generated mock exam paper assembled from the past-paper bank
model MockExam {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String
  subjectCode     String?
  durationMinutes Int
  totalMarks      Int
  topics          String[]
  difficulty      String    @default("mixed")
  // generating | generated | failed | in_progress | completed
  // `generating` means the paper exists but its questions are still being
  // chosen in the background; the client polls until it leaves that state.
  status          String    @default("generated")
  /// Why generation failed, shown to the student. Null unless status=failed.
  generationError String?
  startedAt       DateTime?
  submittedAt     DateTime?
  score           Float?
  createdAt       DateTime  @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MockExamItem[]

  @@index([userId])
  @@map("mock_exams")
}

// Each question selected for a mock exam
// One question on a generated paper.
//
// Exactly one of `questionId` and `bankQuestionId` is set. Two nullable columns
// rather than one, because the two corpora are separate tables and a foreign
// key can only point at one of them -- the same constraint that gives the bank
// its own bookmark and attempt tables. Papers generated before the switch to
// the crop-first bank still carry `questionId`, so both paths have to keep
// resolving; nothing was backfilled or dropped.
model MockExamItem {
  id              String    @id @default(cuid())
  mockExamId      String
  questionId      Int?
  bankQuestionId  Int?
  sectionTitle    String
  order           Int       @default(0)
  // Per-item attempt state
  answer          String?
  score           Float?
  isCorrect       Boolean?
  explanation     String?
  modelAnswer     String?
  strengths       String[]
  weaknesses      String[]
  gradingStatus   String    @default("ungraded") // official | provisional | ungraded
  gradingSourceId Int?
  answerImageUrl  String? // optional photo/screenshot of handwritten working
  gradingMode     String    @default("text") // text | ocr-text | vision -- which path actually graded this item
  attemptedAt     DateTime?

  mockExam     MockExam             @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question     PastPaperQuestion?   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bankQuestion BankQuestion?        @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  scratchpads  QuestionScratchpad[]

  @@index([mockExamId])
  @@map("mock_exam_items")
}

// A student's scratch/working-out drawing for one question, kept separate
// from the submitted answer so it can autosave while they are still
// mid-attempt (before any attempt row exists) and be reopened for continued
// editing afterward. Exactly one of the three question refs is set --
// mirroring MockExamItem's questionId/bankQuestionId split, extended with a
// third ref since a scratchpad can also be scoped to one item within a
// specific mock exam attempt rather than the underlying question bank.
model QuestionScratchpad {
  id                  String    @id @default(cuid())
  userId              String
  pastPaperQuestionId Int?
  bankQuestionId      Int?
  mockExamItemId      String?
  strokesJson         Json // serialized { strokes, textBoxes } from DrawingCanvas
  previewImageUrl     String? // debounced flattened PNG -- what grading/quick display reads
  finalizedAt         DateTime? // set when the parent attempt is submitted; further edits still allowed, but this row is now "the submitted working"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pastPaperQuestion PastPaperQuestion? @relation(fields: [pastPaperQuestionId], references: [id], onDelete: Cascade)
  bankQuestion      BankQuestion?      @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  mockExamItem      MockExamItem?      @relation(fields: [mockExamItemId], references: [id], onDelete: Cascade)

  @@unique([userId, pastPaperQuestionId])
  @@unique([userId, bankQuestionId])
  @@unique([userId, mockExamItemId])
  @@index([userId])
  @@map("question_scratchpads")
}

model QuestionAttempt {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  answer      String
  isCorrect   Boolean?
  score       Float?
  feedback    String?
  timeSpent   Int?
  attemptedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_attempts")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  title     String
  content   String
  tags      String[]
  folderId  String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  folder              NoteFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  linkedQuestions     String[]
  linkedTextbookPages String[]
  collaborators       NoteCollaborator[]

  // Postgres does not index foreign keys automatically. /api/notes filters by
  // userId and orders by updatedAt on every request.
  @@index([userId, updatedAt(sort: Desc)])
  @@map("notes")
}

