// Notebook structure (like OneNote)
model Notebook {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?  @default("#3b82f6")
  icon      String?  @default("📓")
  courseId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sections Section[]

  @@index([userId])
  @@map("notebooks")
}

model Section {
  id         String   @id @default(cuid())
  notebookId String
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  pages    Page[]

  @@index([notebookId, order])
  @@map("sections")
}

model Page {
  id                String   @id @default(cuid())
  sectionId         String
  title             String
  content           String   @default("")
  icon              String   @default("")
  tags              String[] @default([])
  favorite          Boolean  @default(false)
  archived          Boolean  @default(false)
  linkedQuestionIds Int[]    @default([])
  splitQuestionId   Int?
  revision          Int      @default(1)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  section       Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  snapshots     PageSnapshot[]
  collaborators PageCollaborator[]
  comments      PageComment[]
  presences     PagePresence[]
  awareness     PageAwareness[]
  drawings      PageDrawing[]
  yjsUpdates    PageYjsUpdate[]
  yjsSnapshot   PageYjsSnapshot?

  @@index([sectionId, order])
  @@index([favorite])
  @@index([archived])
  @@map("pages")
}

/// Append-only log of raw Yjs update bytes for one page's collaborative
/// session (Feature 5, flagged off by default via `isYjsCollabEnabled()`).
///
/// `Page.content` is NOT replaced by this -- it stays the HTML mirror of the
/// ProseMirror state, written by the exact same debounced-autosave path as
/// every other page, so search/RAG indexing/version history/the read-only
/// path never need to know Yjs exists. This table is purely additive: a
/// joining client reconstructs the live CRDT doc by applying
/// `PageYjsSnapshot.state` (if any) followed by every update after it, then
/// applies new rows as they arrive via the `page_<id>_yjs` NOTIFY channel.
/// Deleting all rows for a page (e.g. turning the flag back off) loses
/// nothing: `Page.content` is already the authoritative document.
model PageYjsUpdate {
  id        String   @id @default(cuid())
  pageId    String
  data      Bytes
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_yjs_updates")
}

/// Periodically compacted merge of a page's `PageYjsUpdate` log (see
/// scripts/compact-page-yjs-updates.ts), so a client joining a
/// long-running session doesn't have to replay the entire update history.
/// One row per page; updates already folded into `state` are pruned from
/// `PageYjsUpdate` by the same compaction pass.
model PageYjsSnapshot {
  id        String   @id @default(cuid())
  pageId    String   @unique
  state     Bytes
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_yjs_snapshots")
}

/// An editable drawing embedded inline in a note page (the "drawingBlock"
/// TipTap node), as an alternative to flattening a drawing to a PNG and
/// losing the ability to reopen and keep editing it.
///
/// The stroke JSON is kept out of `Page.content` deliberately: that column
/// is round-tripped whole on every autosave and version snapshot, so
/// embedding kilobytes of stroke data per drawing directly in the HTML would
/// bloat every one of those. `Page.content` instead holds a `drawingBlock`
/// node referencing this row by id, plus the flattened `thumbnailUrl` for
/// read-only rendering (search, RAG indexing, snapshot history) without
/// needing to fetch and rasterize strokes.
///
/// Concurrent edits to one drawing are last-write-wins, same as the rest of
/// a page before Yjs -- two people editing the same diagram at the same
/// instant is a rare edge case not worth solving before launch.
model PageDrawing {
  id           String   @id @default(cuid())
  pageId       String
  strokesJson  Json
  thumbnailUrl String
  width        Int
  height       Int
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("page_drawings")
}

model PageSnapshot {
  id          String   @id @default(cuid())
  pageId      String
  createdById String?
  title       String
  content     String
  revision    Int
  reason      String   @default("autosave")
  createdAt   DateTime @default(now())

  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@map("page_snapshots")
}

model PageCollaborator {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  role      String   @default("editor") // editor | viewer
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
  @@map("page_collaborators")
}

model PageComment {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  content   String
  anchor    String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId, resolved, createdAt])
  @@map("page_comments")
}

model PagePresence {
  id         String   @id @default(cuid())
  pageId     String
  userId     String
  lastSeenAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId, lastSeenAt])
  @@map("page_presences")
}

// Live awareness state for collaborative editing: cursor position, typing
// indicator, and last-seen heartbeat. Updated via /api/pages/[id]/awareness
// and broadcast to other editors via Postgres LISTEN/NOTIFY + SSE.
model PageAwareness {
  id         String   @id @default(cuid())
  pageId     String
  userId     String
  cursorFrom Int? // ProseMirror text position (start of selection)
  cursorTo   Int? // ProseMirror text position (end of selection)
  typing     Boolean  @default(false)
  lastSeenAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId, lastSeenAt])
  @@map("page_awareness")
}

// Discussion board: a single general community forum. Threads are NOT tied to
// a subject; an optional `category` string lets users loosely tag a thread
// (e.g. "Physics", "Exam Tips"). `subjectId` is kept nullable for legacy rows.
model DiscussionThread {
  id        String   @id @default(cuid())
  subjectId Int?
  category  String?
  userId    String
  title     String
  content   String   @default("")
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  hidden    Boolean  @default(false)
  views     Int      @default(0)
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts   DiscussionPost[]
  votes   DiscussionVote[]
  flags   DiscussionFlag[]

  @@index([subjectId])
  @@index([userId])
  @@index([category])
  @@index([hidden])
  @@map("discussion_threads")
}

// A reply within a thread. Self-referential for nested replies (optional).
model DiscussionPost {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  parentId  String?
  content   String
  hidden    Boolean  @default(false)
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread  DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies DiscussionPost[] @relation("PostReplies")
  votes   DiscussionVote[]
  flags   DiscussionFlag[]

  @@index([threadId])
  @@index([userId])
  @@index([hidden])
  @@map("discussion_posts")
}

// Upvote or downvote on a thread or post. One vote per user per target.
model DiscussionVote {
  id        String   @id @default(cuid())
  threadId  String?
  postId    String?
  userId    String
  direction Int // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now())

  thread DiscussionThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post   DiscussionPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, postId])
  @@index([threadId])
  @@index([postId])
  @@map("discussion_votes")
}

// A user-reported flag on a thread or post. Feeds the moderation queue.
model DiscussionFlag {
  id           String    @id @default(cuid())
  threadId     String?
  postId       String?
  reporterId   String
  reason       String
  status       String    @default("open") // open | dismissed | actioned
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  thread   DiscussionThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post     DiscussionPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User              @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User?             @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, threadId])
  @@unique([reporterId, postId])
  @@index([status, createdAt])
  @@index([threadId])
  @@index([postId])
  @@map("discussion_flags")
}

// Notification for social events: replies to your thread/post, ratings, etc.
// `actorId` is the user who triggered the event; `userId` is the recipient.
model Notification {
  id        String   @id @default(cuid())
  userId    String // recipient (the owner of the thing acted upon)
  actorId   String? // who triggered it (null for system-generated)
  type      String // "discussion_reply" | "discussion_mention" | ...
  entityId  String? // id of the related object (e.g. threadId / postId)
  entityUrl String? // frontend route to open when clicked
  title     String // short summary, e.g. "Someone replied to your thread"
  body      String   @default("") // optional preview text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationsFrom", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// School-provided public resources (PDFs, docx, slides, etc.) — distinct
// from SharedNote (which is user-authored notes). Uploaded by staff for the
// whole school to retrieve. One row per uploaded file.
model SchoolResource {
  id          String   @id @default(cuid())
  uploaderId  String
  title       String
  description String   @default("")
  subject     String?
  category    String? // free-text grouping: "Worksheet", "Slides", "Exam", "Handout"
  folderId    String?
  fileUrl     String
  fileName    String
  fileSize    Int      @default(0)
  mimeType    String   @default("")
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploader User                  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): a folder is an organizational label, not a
  // container the files depend on -- deleting one should never take a
  // student's uploaded file with it. A deleted folder's files fall back to
  // the root listing instead.
  folder   SchoolResourceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([subject])
  @@index([category])
  @@index([createdAt])
  @@index([folderId])
  @@map("school_resources")
}

// A real folder tree for school resources, replacing the old
// "From folder upload: <path>" marker stuffed into `description` and
// re-parsed client-side on every render. Unlike NoteFolder (per-user), this
// tree has no userId: the resource library is one shared school-wide space,
// so its folders are shared too -- any staff member's upload can land in a
// folder any other staff member created.
model SchoolResourceFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  resources SchoolResource[]
  parent    SchoolResourceFolder?  @relation("SchoolResourceSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  SchoolResourceFolder[] @relation("SchoolResourceSubfolders")

  @@index([parentId])
  @@map("school_resource_folders")
}

// Platform-wide announcements published by admins.
model Announcement {
  id          String    @id @default(cuid())
  authorId    String
  title       String
  body        String
  severity    String    @default("info") // info | success | warning | critical
  audience    String    @default("all") // all | students | teachers
  pinned      Boolean   @default(false)
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published])
  @@index([publishedAt])
  @@index([audience])
  @@map("announcements")
}

// ============================================================
// Smart learning features
// ============================================================

// Collaborator on a Note. Owner (note.userId) is implicit; this model tracks
// additional users granted edit access. `role`: editor (read+write) | viewer (read-only).
model NoteCollaborator {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  role      String   @default("editor") // editor | viewer
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
  @@map("note_collaborators")
}

// Records a user's attempt at the daily challenge question.
// One row per user per day (enforced by unique [userId, dateKey]).
// One student's go at the question of the day.
//
// Exactly one of `questionId` and `bankQuestionId` is set, for the same reason
// MockExamItem carries two: the challenge now draws from the crop-first bank,
// where the pool is 66,758 published questions rather than the few hundred the
// legacy table holds, and a foreign key can only point at one of them.
model DailyChallengeAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     Int?
  bankQuestionId Int?
  dateKey        String // YYYY-MM-DD — the challenge day
  answer         String   @default("")
  score          Float?
  isCorrect      Boolean?
  attemptedAt    DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     PastPaperQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bankQuestion BankQuestion?      @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@map("daily_challenge_attempts")
}

// Competition math/physics question bank — stored separately from PastPaperQuestion
// so the main past-paper DB can be wiped/replaced without losing competition data.
// Currently populated with the STEP database (1986 Specimen – 2018), with room to
// grow to AMC/AIME/USAMO etc. via the `competition` discriminator.
model CompetitionQuestion {
  id          Int      @id @default(autoincrement())
  competition String   @default("STEP") // STEP | AMC10 | AMC12 | AIME | ...
  code        String // e.g. "16-S1-Q1", "2024-AMC12-P22"
  yearLabel   String // e.g. "16", "Spec", "2024"
  paper       String // e.g. "S1" | "P22"
  number      Int // question number within the paper
  title       String // human label, same as code for STEP
  body        String   @default("") // HTML body (description + embedded img)
  labels      String[] @default([]) // topic tags, e.g. ["Inequalities", "Complex numbers"]
  imageUrl    String? // local path under /public, e.g. "/step-images/Spec-S1-Q1.png"
  pdfUrl      String? // link to the full paper PDF on the source site
  texUrl      String? // link to the .tex source on the source site
  sourceSite  String   @default("stepdatabase.maths.org")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([competition, code])
  @@index([competition])
  @@index([yearLabel])
  @@index([paper])
  @@map("competition_questions")
}

// Cloud-synced document — the shared format for cross-platform note sync.
// Both the web Note editor and the iPad BetterNotes app read/write this.
//
// Format contract:
//   format: "hybrid"  — body is markdown-with-LaTeX ($...$, $$...$$);
//                       blocks is an optional array of spatial elements
//                       (used by the iPad canvas editor).
//   format: "markdown" — body only, blocks is null/empty.
//
// Sync strategy: last-write-wins per document, keyed on (ownerId, clientId).
// `revision` increments on each upsert; clients send their last-seen revision
// and the server rejects stale writes with 409.
model CloudDocument {
  id        String    @id @default(cuid())
  ownerId   String // User.id of the owner
  clientId  String // stable client-side id (notebook id on iPad / note id on web)
  title     String    @default("Untitled")
  format    String    @default("hybrid") // hybrid | markdown
  body      String    @default("") // markdown with $latex$
  blocks    Json? // spatial elements (iPad canvas)
  revision  Int       @default(1)
  deletedAt DateTime? // soft-delete tombstone (for sync)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, clientId])
  @@index([ownerId, updatedAt])
  @@map("cloud_documents")
}

// ============================================================
// V4 Question Bank — extraction store
// ============================================================
//
// Local SQLite is the working store; these models are for the
// Neon Postgres merge target. One row per ROOT question — sub-parts
// live inside body_md, never as separate rows.

model BankSubject {
  id    Int     @id @default(autoincrement())
  board String // CAIE | IB
  code  String // 9709, or an IB subject slug
  name  String
  level String? // igcse | a-level | HL | SL

  papers BankPaper[]
  topics BankTopic[]

  @@unique([board, code, level])
  @@map("bank_subjects")
}

model BankPaper {
  id           Int      @id @default(autoincrement())
  subjectId    Int
  board        String
  year         Int
  session      String // s | w | m, or May | November
  paperNumber  Int
  variant      Int      @default(0)
  timezone     String? // IB TZ1 / TZ2
  docType      String // qp | ms | in
  sourcePath   String
  sourceSha256 String
  pageCount    Int      @default(0)
  spanStrategy String? // prose | ms_table | answer_key
  usedOcr      Boolean  @default(false)
  createdAt    DateTime @default(now())

  subject     BankSubject      @relation(fields: [subjectId], references: [id])
  questions   BankQuestion[]
  markSchemes BankMarkScheme[]
  reviewFlags BankReviewFlag[]

  @@unique([sourcePath])
  @@index([subjectId])
  @@index([board, year, session, paperNumber, variant, docType])
  @@index([sourceSha256])
  @@map("bank_papers")
}

model BankQuestion {
  id                  Int      @id @default(autoincrement())
  paperId             Int
  rootNumber          Int
  bodyMd              String
  // Mirrors PastPaperQuestion.hasDiagram -- routes grading to gradeWithVision
  // instead of OCR-then-text-grade, since a diagram/graph/circuit answer has
  // no text for OCR to usefully extract.
  requiresDiagram     Int      @default(0)
  parts               String   @default("[]") // JSON [{"label": "a(i)", "marks": 3}]
  totalMarks          Int?
  screenshotId        Int?
  pageStart           Int?
  pageEnd             Int?
  confidence          Float    @default(0)
  status              String   @default("needs_review") // published | needs_review
  reviewedBy          String?
  reviewedAt          DateTime?
  difficulty          Int? // 1-5
  difficultySource    String? // llm | empirical | manual
  difficultyRationale String?
  runId               String?
  model               String?
  promptVersion       String?
  createdAt           DateTime @default(now())

  paper                  BankPaper               @relation(fields: [paperId], references: [id], onDelete: Cascade)
  screenshot             BankAsset?              @relation("QuestionScreenshot", fields: [screenshotId], references: [id])
  strips                 BankQuestionStrip[]
  assets                 BankQuestionAsset[]
  topics                 BankQuestionTopic[]
  tags                   BankQuestionTag[]
  skills                 BankQuestionSkill[]
  reviewFlags            BankReviewFlag[]
  markScheme             BankMarkScheme?
  bookmarks              BankQuestionBookmark[]
  attempts               BankQuestionAttempt[]
  mockExamItems          MockExamItem[]
  scratchpads            QuestionScratchpad[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  reviewItems            ReviewItem[]
  studyTasks             StudyTask[]

  @@unique([paperId, rootNumber])
  @@index([paperId])
  @@index([status])
  @@index([difficulty])
  @@map("bank_questions")
}

// Star/bookmark for a crop-first bank question.
//
// A third bookmark table, because there are three question tables and a
// foreign key can only point at one of them: `Bookmark` targets the legacy
// Question, `PastPaperBookmark` the transcribed PastPaperQuestion, and this
// the BankQuestion a student actually browses. Merging them would mean giving
// up referential integrity on all three.
model BankQuestionBookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId Int
  note       String? // optional user memo
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("bank_question_bookmarks")
}

// An attempt at a crop-first bank question.
//
// A fourth attempt table, for the same reason there is a third bookmark table:
// a foreign key can only point at one question table. `QuestionAttempt` targets
// the legacy Question, `PastPaperAttempt` the transcribed PastPaperQuestion,
// and this the BankQuestion a student actually browses. Until this existed the
// bank had no attempt path at all, so "Questions Answered" on the dashboard
// could not move off zero however much the bank was used.
//
// Unlike the bookmark table there is no unique constraint: re-attempting a
// question is the point, and the history is what the accuracy tile reads.
model BankQuestionAttempt {
  id                 String   @id @default(cuid())
  userId             String
  questionId         Int
  answer             String
  // Null when nothing could mark it -- a free-response question whose mark
  // scheme has no answer key, left for the student to self-mark. Distinct from
  // false, which means marked and wrong.
  isCorrect          Boolean?
  score              Float?
  // Both readings of the same attempt, kept apart from `score` so marking bias
  // stays measurable: `score` is a fraction and no longer says who marked it.
  // Null unless the attempt was actually marked that way.
  selfAwardedScore   Float?
  authoritativeScore Float?
  // The marks the student awarded, in the unit they thought in. `outOfMarks`
  // is stored alongside because the question's total can change under a
  // re-extraction and a stored ratio must not silently move with it.
  awardedMarks       Int?
  outOfMarks         Int?
  // key  -- compared against BankMarkScheme.answerLetter, no model involved
  // self -- the student marked their own work against the mark scheme
  // ai   -- graded by the model, for free-response questions with a transcript
  gradedBy           String
  timeSpent          Int?
  answerImageUrl     String? // optional photo/scratchpad snapshot of drawn working -- mirrors PastPaperAttempt/MockExamItem
  gradingMode        String   @default("text") // text | ocr-text | vision -- which path graded this attempt, within gradedBy: 'ai'
  createdAt          DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // The dashboard tiles read every attempt for one user, newest first.
  @@index([userId, createdAt])
  @@index([questionId])
  @@map("bank_question_attempts")
}

model BankMarkScheme {
  id            Int      @id @default(autoincrement())
  questionId    Int      @unique
  paperId       Int
  rootNumber    Int
  answerMd      String
  markingPoints String   @default("[]") // JSON [{"mark_code": "M1", "marks": 1, ...}]
  totalMarks    Int?
  answerLetter  String? // for MCQ papers
  confidence    Float    @default(0)
  status        String   @default("needs_review")
  runId         String?
  model         String?
  promptVersion String?
  createdAt     DateTime @default(now())

  paper    BankPaper             @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question BankQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  strips   BankMarkSchemeStrip[]
  assets   BankMarkSchemeAsset[]

  @@unique([paperId, rootNumber])
  @@index([questionId])
  @@map("bank_mark_schemes")
}

model BankAsset {
  id           Int      @id @default(autoincrement())
  sha256       String   @unique
  kind         String // figure | table | screenshot
  relativePath String // assets/sha256/<ab>/<sha>.png
  width        Int?
  height       Int?
  byteSize     Int?
  sourcePage   Int?
  bbox         String? // JSON [x0, y0, x1, y1]
  sourceDpi    Int      @default(200)
  createdAt    DateTime @default(now())

  screenshots      BankQuestion[]        @relation("QuestionScreenshot")
  questionAssets   BankQuestionAsset[]
  markSchemeAssets BankMarkSchemeAsset[]
  questionStrips   BankQuestionStrip[]
  markSchemeStrips BankMarkSchemeStrip[]

  @@map("bank_assets")
}

/// The rendered crop, in reading order.
///
/// screenshotId holds only the first strip, which is all a transcription-first
/// bank needed. 89% of questions render as two or more strips, so in crop-first
/// mode that column shows a student the top fragment of most questions.
model BankQuestionStrip {
  questionId Int
  assetId    Int
  ordering   Int
  page       Int

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  asset    BankAsset    @relation(fields: [assetId], references: [id])

  @@id([questionId, ordering])
  @@index([assetId])
  @@map("bank_question_strips")
}

model BankMarkSchemeStrip {
  markSchemeId Int
  assetId      Int
  ordering     Int
  page         Int

  markScheme BankMarkScheme @relation(fields: [markSchemeId], references: [id], onDelete: Cascade)
  asset      BankAsset      @relation(fields: [assetId], references: [id])

  @@id([markSchemeId, ordering])
  @@index([assetId])
  @@map("bank_mark_scheme_strips")
}

model BankQuestionAsset {
  questionId  Int
  assetId     Int
  placeholder String // fig1, fig2, etc.
  ordering    Int      @default(0)
  createdAt   DateTime @default(now())

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  asset    BankAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([questionId, placeholder])
  @@map("bank_question_assets")
}

model BankMarkSchemeAsset {
  markSchemeId Int
  assetId      Int
  placeholder  String
  ordering     Int      @default(0)
  createdAt    DateTime @default(now())

  markScheme BankMarkScheme @relation(fields: [markSchemeId], references: [id], onDelete: Cascade)
  asset      BankAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([markSchemeId, placeholder])
  @@map("bank_mark_scheme_assets")
}

// Syllabus-canonical topics for filtering by course outline
model BankTopic {
  id        Int     @id @default(autoincrement())
  subjectId Int
  code      String? // syllabus reference, e.g. "3.2"
  name      String

  subject   BankSubject         @relation(fields: [subjectId], references: [id])
  questions BankQuestionTopic[]

  @@unique([subjectId, name])
  @@map("bank_topics")
}

model BankQuestionTopic {
  questionId Int
  topicId    Int
  confidence Float    @default(0)
  createdAt  DateTime @default(now())

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    BankTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([questionId, topicId])
  @@map("bank_question_topics")
}

// Free-form search tags (what students actually type)
model BankTag {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String

  questions BankQuestionTag[]

  @@map("bank_tags")
}

model BankQuestionTag {
  questionId Int
  tagId      Int
  confidence Float    @default(0)
  createdAt  DateTime @default(now())

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      BankTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("bank_question_tags")
}

// Command words -- "calculate", "evaluate", "to what extent".
//
// Separate from BankTag because the vocabularies do different work: a tag is
// what a student types into search, a skill is a closed list the mark scheme
// rewards against. Mixing them would pollute search and blur the drilling.
model BankSkill {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String

  questions BankQuestionSkill[]

  @@map("bank_skills")
}

model BankQuestionSkill {
  questionId Int
  skillId    Int
  confidence Float    @default(0)
  createdAt  DateTime @default(now())

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    BankSkill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
  @@index([skillId])
  @@map("bank_question_skills")
}

// QA advisory queue — never blocks writes, only routes to review
model BankReviewFlag {
  id         Int      @id @default(autoincrement())
  questionId Int?
  paperId    Int?
  issueType  String // marks_mismatch | latex_invalid | ...
  severity   String // low | medium | high
  message    String
  evidence   String? // JSON
  status     String   @default("open") // open | resolved | dismissed
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime @default(now())

  question BankQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  paper    BankPaper?    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([status, issueType])
  @@index([paperId, status, severity])
  @@map("bank_review_flags")
}

// Per-question resume ledger for fault-tolerant long runs
model BankRunLedger {
  workKey      String   @id // sha256(source + span + model + prompt)
  stage        String // transcribe | tag
  sourceSha256 String
  rootNumber   Int?
  status       String // ok | failed
  detail       String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  completedAt  DateTime @default(now())

  @@index([sourceSha256])
  @@index([status, stage])
  @@map("bank_run_ledger")
}

/// Durable rate-limit counters.
///
/// The previous limiter was a per-process in-memory Map. On serverless every
/// invocation gets a fresh process, so the limits were effectively unenforced:
/// the login brute-force guard and the per-user AI spend caps both silently
/// did nothing across more than one instance.
///
/// One row per limiter key (e.g. "signup:1.2.3.4", "token-account:a@b.c",
/// a bare user id for the AI limiters). Rows are disposable — expired ones are
/// cleaned up opportunistically and can be truncated at any time.
/// Grade thresholds, so a raw mark can become the grade a student is asked about.
///
/// `source` is load-bearing: CAIE publishes thresholds per session
/// (`published`), the IB does not and schools receive their own (`school`), and
/// anything else is an `estimate` the UI has to label as one.
model GradeBoundary {
  id          Int      @id @default(autoincrement())
  board       String // CAIE | IB
  subjectCode String
  level       String? // igcse | a-level | HL | SL
  year        Int?
  session     String?
  /// Null when the row is a subject-wide fallback rather than one paper.
  paperNumber Int?
  grade       String // A* | A | ... | E, or 7 | 6 | ... | 1
  minMark     Int
  totalMarks  Int
  source      String   @default("estimate") // published | school | estimate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([board, subjectCode, level, year, session, paperNumber, grade], name: "grade_boundaries_identity_key")
  @@index([board, subjectCode, year])
  @@map("grade_boundaries")
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  // Supports the opportunistic sweep of expired windows.
  @@index([resetAt])
  @@map("rate_limits")
}

/// Server-side errors, captured by `onRequestError` in instrumentation.ts and
/// by `reportError()` for work that runs outside a request (background jobs).
/// There is no third-party error service; this table is the record.
model ErrorEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// Stable hash of message + route, so repeats of one bug group together.
  fingerprint String
  message     String
  stack       String?
  /// React's error digest, when the error came through a render.
  digest      String?
  path        String?
  method      String?
  routePath   String?
  routeType   String?
  source      String   @default("request")

  @@index([createdAt])
  @@index([fingerprint])
  @@map("error_events")
}
