# ---- Database ----
# Postgres connection string (Neon, Supabase, or self-hosted).
# REQUIRED. The app refuses to start without it (lib/env.ts) rather than
# silently falling back to a localhost socket.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (UNPOOLED) connection string, used only for LISTEN/NOTIFY.
# Required whenever DATABASE_URL points at a transaction-mode pooler — Neon's
# "-pooler" host, Supabase port 6543, or any pgbouncer. LISTEN does not work
# through one: real-time collaboration connects and then silently never
# receives an update. Leave unset if DATABASE_URL is already a direct
# connection. Also used by `prisma migrate deploy`.
DIRECT_DATABASE_URL=""

# ---- Object storage (past papers, uploads, question images) ----
# "local" (default) reads and writes the filesystem: pdf_extraction/,
# public/uploads/, public/extracted_images/, public/step-images/.
# That is right for development and for a self-hosted box with real disks.
#
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO) and is REQUIRED on a serverless host, where the filesystem is
# read-only, empty and discarded between requests — every past paper, avatar
# and diagram would 404. The app refuses to start in production with
# STORAGE_DRIVER unset (override with STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true).
#
# After setting these, upload the existing corpus once:
#   npm run storage:sync            # add --dry-run first to preview
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Temporary credentials only (AWS STS). Leave blank for a static key pair.
STORAGE_SESSION_TOKEN=""
# AWS: the bucket's region, e.g. "eu-west-2". Cloudflare R2 ignores the region
# but still requires one in the signature — use "auto".
STORAGE_REGION="auto"
# Leave blank for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://127.0.0.1:9000
STORAGE_ENDPOINT=""
# Bucket in the path (https://host/bucket/key) rather than the hostname.
# Defaults to true when STORAGE_ENDPOINT is set, which is what R2 and MinIO
# need; set "false" for an S3-compatible host that wants virtual-hosted style.
STORAGE_FORCE_PATH_STYLE=""
# If the bucket sits behind a public CDN, put its origin here and objects are
# served from unsigned, cacheable URLs instead of presigned ones. Only set this
# for a bucket whose contents may be public — past papers are copyright
# material and student uploads are private, so usually leave it blank.
STORAGE_PUBLIC_BASE_URL=""
# Lifetime in seconds of a presigned download URL. Default 900 (15 minutes).
STORAGE_SIGNED_URL_TTL="900"

# Per-request timeout in ms for the s3 driver (default 30000). Leave unset for
# the app: a serverless handler must answer inside its own function timeout.
# Raise it only for `npm run storage:sync`, where a multi-megabyte PDF pushed
# from a home connection can legitimately take longer than 30s.
STORAGE_REQUEST_TIMEOUT_MS=""

# ---- Realtime / SSE ----
# "sse" (default) or "off". Set to "off" where LISTEN/NOTIFY cannot work; the
# collaboration endpoint then reports that cleanly and clients stop retrying
# instead of reconnecting in a loop.
COLLAB_REALTIME="sse"
# Max lifetime of one SSE connection, in ms. Must stay BELOW your platform's
# serverless function timeout so the server closes the stream cleanly rather
# than the platform killing it mid-flight — the browser cannot tell that apart
# from a network fault, so every client would take an error path forever.
# Default 50000, which fits Vercel Hobby's 60s ceiling. On a plan with longer
# functions, raise this and `maxDuration` in the two stream routes together.
SSE_MAX_LIFETIME_MS="50000"

# ---- NextAuth ----
# REQUIRED in production — without it NextAuth signs sessions with an insecure
# development default and every token becomes forgeable.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# AUTH_SECRET is accepted as an alias for NEXTAUTH_SECRET.
AUTH_SECRET=""
# Leave NEXTAUTH_URL unset during local development; the app derives the
# current host and port from each request. In production, set the exact public
# HTTPS origin (no trailing slash), for example:
# NEXTAUTH_URL="https://study.example.com"
# OAuth provider callback URLs must use the same origin, followed by
# /api/auth/callback/<provider>.
NEXTAUTH_URL=""

# ---- Admin access ----
# Comma-separated list of email addresses granted admin rights regardless of
# their stored role. REQUIRED in production: with this empty there is no
# bootstrap admin and nobody can reach /admin.
ADMIN_EMAILS="you@school.org"

# ---- DeepSeek (AI tutor, grading, mock exams) ----
# Get a key at https://platform.deepseek.com. NEVER commit a real key.
# SECURITY: rotate any key that was previously committed to git history.
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"
# Hard app-side allowance per user, per UTC month. Paid AI routes reserve their
# worst-case cost atomically in Postgres before contacting the provider, so
# concurrent serverless requests cannot race past the ceiling.
AI_MONTHLY_USER_SPEND_LIMIT_USD="5"
# Conservative USD reservation for one provider call. Increase this when using
# a more expensive model. A 12-question mock submission reserves 12x this.
AI_REQUEST_RESERVE_USD="0.02"
# Total wall-clock budget for one text completion, including its one retry.
AI_REQUEST_BUDGET_MS="45000"

# ---- Vision / OCR (handwritten answer recognition) ----
# lib/vision.ts uses SiliconFlow first, falling back to Gemini. Both optional;
# with neither set, handwriting upload degrades to manual text entry.
#
# SILICONFLOW_API_KEY is the CANONICAL name for the project's single SiliconFlow
# key. It is read by the web app's OCR path (lib/vision.ts) and by the Python
# extraction pipeline (pdf_extraction/lib/vision_client.py).
#
# The V3 batch scripts under scripts/ have historically held the same key as
# V3_OPENAI_API_KEY (see the pipeline section at the bottom). Both names are now
# accepted on both sides, so one key anywhere in the environment powers
# everything — but prefer SILICONFLOW_API_KEY for new setups. The alias is only
# honoured while V3_OPENAI_CHAT_COMPLETIONS_URL is unset or points at
# api.siliconflow.cn: a key for some other OpenAI-compatible provider must never
# be sent to SiliconFlow.
SILICONFLOW_API_KEY=""
# SiliconFlow vision model. Default "Qwen/Qwen3-VL-32B-Instruct".
VISION_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Must include the API version segment — lib/vision.ts appends "/models/...".
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
# Total OCR/vision wall-clock budget, including bounded retries.
VISION_BUDGET_MS="20000"

# ---- OAuth Providers (all optional) ----
# Google is the only OAuth provider. It is registered — and its button only
# rendered on the login page — when BOTH its id and secret are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Easter eggs ----
# Passphrase for the competition vault. Not a security boundary — it gates
# non-sensitive bonus content only.
COMPETITION_PASSPHRASE=""

# ---- Python extraction pipeline (pdf_extraction/, not used by the web app) ----
# V3_OPENAI_API_KEY is an ALIAS for SILICONFLOW_API_KEY, not a second account:
# the V3 scripts pin the endpoint to api.siliconflow.cn and the model to
# Qwen3-VL, so the "OPENAI" in the name refers to the wire format, not the
# provider. Set SILICONFLOW_API_KEY and leave this blank unless you have a
# reason to give the pipeline a different key.
V3_OPENAI_API_KEY=""
# Overrides for the pinned SiliconFlow endpoint/model. Leave blank: the V3
# scripts refuse to run against anything other than api.siliconflow.cn and
# Qwen/Qwen3-VL-32B-Instruct, and pointing this at another provider also
# disables the V3_OPENAI_API_KEY alias above.
V3_OPENAI_CHAT_COMPLETIONS_URL=""
V3_OPENAI_MODEL=""
V3_OPENAI_MAX_ATTEMPTS="3"
V3_OPENAI_TIMEOUT_SECONDS="120"
# Local paths used by the extraction scripts.
EXTRACT_DB="papers.db"
PAPERS_DB="papers.db"
PDF_DIR="pdf_extraction/my_raw_pdfs"
