# ---- Database ----
# Postgres connection string (Neon, Supabase, or self-hosted).
# REQUIRED. The app refuses to start without it (lib/env.ts) rather than
# silently falling back to a localhost socket.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (UNPOOLED) connection string, used only for LISTEN/NOTIFY.
# Required whenever DATABASE_URL points at a transaction-mode pooler — Neon's
# "-pooler" host, Supabase port 6543, or any pgbouncer. LISTEN does not work
# through one: real-time collaboration connects and then silently never
# receives an update. Leave unset if DATABASE_URL is already a direct
# connection. Also used by `prisma migrate deploy`.
DIRECT_DATABASE_URL=""

# ---- Object storage (past papers, uploads, question images) ----
# "local" (default) reads and writes the filesystem: pdf_extraction/,
# public/uploads/, public/extracted_images/, public/step-images/.
# That is right for development and for a self-hosted box with real disks.
#
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO) and is REQUIRED on a serverless host, where the filesystem is
# read-only, empty and discarded between requests — every past paper, avatar
# and diagram would 404. The app refuses to start in production with
# STORAGE_DRIVER unset (override with STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true).
#
# After setting these, upload the existing corpus once:
#   npm run storage:sync            # add --dry-run first to preview
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Temporary credentials only (AWS STS). Leave blank for a static key pair.
STORAGE_SESSION_TOKEN=""
# AWS: the bucket's region, e.g. "eu-west-2". Cloudflare R2 ignores the region
# but still requires one in the signature — use "auto".
STORAGE_REGION="auto"
# Leave blank for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://127.0.0.1:9000
STORAGE_ENDPOINT=""
# Bucket in the path (https://host/bucket/key) rather than the hostname.
# Defaults to true when STORAGE_ENDPOINT is set, which is what R2 and MinIO
# need; set "false" for an S3-compatible host that wants virtual-hosted style.
STORAGE_FORCE_PATH_STYLE=""
# If the bucket sits behind a public CDN, put its origin here and objects are
# served from unsigned, cacheable URLs instead of presigned ones. Only set this
# for a bucket whose contents may be public — past papers are copyright
# material and student uploads are private, so usually leave it blank.
STORAGE_PUBLIC_BASE_URL=""
# Lifetime in seconds of a presigned download URL. Default 900 (15 minutes).
STORAGE_SIGNED_URL_TTL="900"

# Per-request timeout in ms for the s3 driver (default 30000). Leave unset for
# the app: a serverless handler must answer inside its own function timeout.
# Raise it only for `npm run storage:sync`, where a multi-megabyte PDF pushed
# from a home connection can legitimately take longer than 30s.
STORAGE_REQUEST_TIMEOUT_MS=""

# ---- Realtime / SSE ----
# "sse" (default) or "off". Set to "off" where LISTEN/NOTIFY cannot work; the
# collaboration endpoint then reports that cleanly and clients stop retrying
# instead of reconnecting in a loop.
COLLAB_REALTIME="sse"
# Max lifetime of one SSE connection, in ms. Must stay BELOW your platform's
# serverless function timeout so the server closes the stream cleanly rather
# than the platform killing it mid-flight — the browser cannot tell that apart
# from a network fault, so every client would take an error path forever.
# Default 50000, which fits Vercel Hobby's 60s ceiling. On a plan with longer
# functions, raise this and `maxDuration` in the two stream routes together.
SSE_MAX_LIFETIME_MS="50000"

# ---- NextAuth ----
# REQUIRED in production — without it NextAuth signs sessions with an insecure
# development default and every token becomes forgeable.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# AUTH_SECRET is accepted as an alias for NEXTAUTH_SECRET.
AUTH_SECRET=""
# Leave NEXTAUTH_URL unset during local development; the app derives the
# current host and port from each request. In production, set the exact public
# HTTPS origin (no trailing slash), for example:
# NEXTAUTH_URL="https://study.example.com"
# OAuth provider callback URLs must use the same origin, followed by
# /api/auth/callback/<provider>.
NEXTAUTH_URL=""

# ---- Admin access ----
# Comma-separated list of email addresses granted admin rights regardless of
# their stored role. REQUIRED in production: with this empty there is no
# bootstrap admin and nobody can reach /admin.
ADMIN_EMAILS="you@school.org"

# ---- Credential encryption (REQUIRED for AI features) ----
# Students bring their own AI API keys. Those are real, billable third-party
# credentials belonging to teenagers, so they are stored encrypted with
# AES-256-GCM (lib/credential-crypto.ts) rather than in plaintext. This is the
# secret that seals them.
#
# Generate one with:
#     openssl rand -base64 32
#
# It must decode to exactly 32 bytes; the app refuses to start storing keys
# otherwise, and the AI Provider panel in Account Settings tells the user so.
#
# *** WARNING: ROTATING THIS KEY MAKES EVERY STORED API KEY UNREADABLE. ***
# There is no recovery path and no dual-read window — decryption fails, the
# settings page tells each affected student their key could not be read, and
# every one of them must paste theirs in again. Treat it like a database
# password: back it up, and change it only in a deliberate incident response.
CREDENTIAL_ENCRYPTION_KEY=""

# ---- Shared server AI key (OPTIONAL) ----
# The platform is bring-your-own-key: a user who supplies their own API key,
# endpoint and model in Account Settings → AI Provider always gets their own,
# and it is never substituted.
#
# The variables below are the OWNER'S OWN key, used for everyone else. It was
# reachable only by accounts an admin granted via POST /api/admin/ai-access,
# because it spent the owner's money and an ungranted student reaching it was
# a bill rather than a bug report. Since 27 Sep 2026 it serves OpenCode Zen's
# free models, so SHARED_AI_OPEN_TO_ALL opens it to every signed-in account
# and the monthly cap below is skipped while the model stays free. The grant
# still works and still matters if this is ever pointed back at a paid
# provider. Leave these blank to have no shared key at all.
#
# NEVER commit a real key.
# SECURITY: rotate any key that was previously committed to git history.
#
# SHARED_AI_* is the canonical spelling; the DEEPSEEK_* names below are what
# these were called before BYOK and still work as a fallback, so nothing breaks
# on the deploy that renames them. Prefer the new names: since 27 Sep 2026 the
# shared key is an OpenCode Zen key, and a variable called DEEPSEEK_API_KEY
# holding a key for another provider misleads whoever reads it next.
#
# The base URL may be bare (https://opencode.ai/zen/v1) or fully qualified;
# it is normalised to /chat/completions either way.
#
# Free models, all OpenAI-compatible, all listed in FREE_MODELS in
# lib/ai-pricing.ts -- read the terms recorded there before switching:
#   zero-retention, no training  space-bunny-free, longcat-2.5-preview-free
#   may train on submissions     mimo-v2.6-flash-free (default), big-pickle,
#                                mimo-v2.5-free, ling-3.0-flash-fin-free
#
# The default is mimo-v2.6-flash-free. OpenCode documents no context window,
# speed or vendor for any of these, so the choice rests on two things that are
# knowable: it is the newer MiMo, and it is the flash variant. Latency is the
# failure this codebase has actually hit -- the tutor and mock generation both
# timed out at the 45s budget on the previous shared provider, which is the
# entire reason AI_INTERACTIVE_MODEL exists. If 2.6-flash turns out too weak on
# multi-step reasoning, mimo-v2.5-free is the one to try next; nothing in the
# code needs to change, only this value.
# NOT eligible: nemotron-3-ultra-free and nemotron-3.5-lightning-free, whose
# NVIDIA trial terms say "do not submit personal or confidential data" -- this
# platform sends a named student's own work. muse-spark and jev speak
# /responses and /systemone, which this codebase cannot call.
SHARED_AI_API_KEY=""
SHARED_AI_BASE_URL="https://opencode.ai/zen/v1"
SHARED_AI_MODEL="mimo-v2.6-flash-free"
# Set to "on" to let EVERY signed-in account use the shared key, rather than
# only accounts an admin granted. Off unless set, so a deployment that inherits
# a paid key cannot hand it to the whole school by default. Signing in already
# proves a verified, unbanned account, so there is no separate check.
SHARED_AI_OPEN_TO_ALL="on"
# Optional. A lower-latency model for calls with a student waiting on them --
# the tutor, hints, marking one free-response answer. Measured medians on the
# shared provider run 7-27s with a tail past 90, which is what made the tutor
# and mock generation time out at the budget below. Batch work keeps
# SHARED_AI_MODEL. Applies to the SHARED key only: a student who supplied
# their own key chose their own model and it is not substituted.
# Leave blank to use SHARED_AI_MODEL everywhere. If it is set, it must ALSO be
# a free model or the monthly cap starts applying again -- it is swapped in on
# exactly the calls a student is waiting on.
#
# Deliberately blank: SHARED_AI_MODEL is already the flash variant, so there is
# nothing faster to swap in and a second knob holding the same value would only
# mislead. Set it if SHARED_AI_MODEL is ever moved to a heavier model.
AI_INTERACTIVE_MODEL=""
# Hard app-side allowance per user, per UTC month, for the SHARED key only.
# Skipped entirely while the shared model is in FREE_MODELS: the reservation is
# a flat AI_REQUEST_RESERVE_USD per call and is never refunded, so on a free
# model it is a 250-calls-a-month quota protecting nothing, and students would
# be stopped partway through term by a message about money they never spent.
# Paid AI routes reserve their worst-case cost atomically in Postgres before
# contacting the provider, so concurrent serverless requests cannot race past
# the ceiling. A user spending their own key skips this — their provider bills
# them directly — but still passes the per-minute rate limiter, which protects
# this platform rather than the owner's wallet.
AI_MONTHLY_USER_SPEND_LIMIT_USD="5"
# Conservative USD reservation for one provider call. Increase this when using
# a more expensive model. A 12-question mock submission reserves 12x this.
AI_REQUEST_RESERVE_USD="0.02"
# Total wall-clock budget for one text completion, including its one retry.
AI_REQUEST_BUDGET_MS="45000"

# ---- Vision / OCR (handwritten answer recognition) ----
# Under bring-your-own-key these are the OWNER'S keys, used only by accounts an
# admin has granted shared access. A student who supplies their own key sends
# their own vision model to their own endpoint instead; a student who supplied a
# text-only model gets text AI with handwriting OCR reported as unavailable.
# Both optional; with neither set, a granted account degrades to manual entry.
#
# SILICONFLOW_API_KEY is the CANONICAL name for the project's single SiliconFlow
# key. It is read by the web app's OCR path (lib/ai-credentials.ts) and by the
# Python extraction pipeline (pdf_extraction/lib/vision_client.py).
#
# The V3 batch scripts under scripts/ have historically held the same key as
# V3_OPENAI_API_KEY (see the pipeline section at the bottom). Both names are
# accepted on both sides, so one key anywhere in the environment powers
# everything — but prefer SILICONFLOW_API_KEY for new setups. The alias is only
# honoured while V3_OPENAI_CHAT_COMPLETIONS_URL is unset or points at
# api.siliconflow.cn: a key for some other OpenAI-compatible provider must never
# be sent to SiliconFlow.
SILICONFLOW_API_KEY=""
# SiliconFlow vision model. Default "Qwen/Qwen3-VL-32B-Instruct".
VISION_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Must include the API version segment — lib/vision.ts appends "/models/...".
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
# Total OCR/vision wall-clock budget, including bounded retries.
VISION_BUDGET_MS="20000"

# ---- OAuth Providers (all optional) ----
# Google is the only OAuth provider. It is registered — and its button only
# rendered on the login page — when BOTH its id and secret are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Transactional email (Resend) ----
# Powers self-service password reset (/auth/forgot-password). WITHOUT THIS KEY
# THE RESET FLOW IS DISABLED: /api/auth/forgot-password answers 503 with
# "Password reset is temporarily unavailable" for every address — deliberately
# for every address, so a missing key cannot become an account-enumeration
# oracle — and the only recovery path is an admin setting a password by hand
# (/api/admin/users/reset-password). Nothing else in the app sends email, so
# leaving it blank breaks password reset and nothing more.
#
# Setup, once:
#   1. Create an account at https://resend.com (the free tier is enough:
#      3,000 emails/month, 100/day).
#   2. Domains -> Add Domain -> busypizza.bond, then add the DKIM, SPF and
#      MX/return-path DNS records it shows you and wait for "Verified".
#      Sending from an unverified domain is rejected with HTTP 403.
#   3. API Keys -> Create API Key with "Sending access" only. It is shown
#      once; paste it here. It starts with "re_".
#   4. Make sure NEXTAUTH_URL is the real public origin — reset links are
#      built from it, never from the request's Host header (which an attacker
#      could set to point the link at their own domain).
RESEND_API_KEY=""
# From address for outgoing mail. The domain must be the verified one above.
# Defaults to "YKPao Study <no-reply@busypizza.bond>" when blank.
EMAIL_FROM=""

# ---- Easter eggs ----
# Passphrase for the competition vault. Not a security boundary — it gates
# non-sensitive bonus content only.
COMPETITION_PASSPHRASE=""

# ---- Python extraction pipeline (pdf_extraction/, not used by the web app) ----
# V3_OPENAI_API_KEY is an ALIAS for SILICONFLOW_API_KEY, not a second account:
# the V3 scripts pin the endpoint to api.siliconflow.cn and the model to
# Qwen3-VL, so the "OPENAI" in the name refers to the wire format, not the
# provider. Set SILICONFLOW_API_KEY and leave this blank unless you have a
# reason to give the pipeline a different key.
V3_OPENAI_API_KEY=""
# Overrides for the pinned SiliconFlow endpoint/model. Leave blank: the V3
# scripts refuse to run against anything other than api.siliconflow.cn and
# Qwen/Qwen3-VL-32B-Instruct, and pointing this at another provider also
# disables the V3_OPENAI_API_KEY alias above.
V3_OPENAI_CHAT_COMPLETIONS_URL=""
V3_OPENAI_MODEL=""
V3_OPENAI_MAX_ATTEMPTS="3"
V3_OPENAI_TIMEOUT_SECONDS="120"
# Local paths used by the extraction scripts.
EXTRACT_DB="papers.db"
PAPERS_DB="papers.db"
PDF_DIR="pdf_extraction/my_raw_pdfs"

# --- Error reporting -------------------------------------------------------
# Server errors are always written to the `error_events` table and shown in the
# admin console. Set this to also push a copy somewhere you will actually see
# it -- a Slack or Discord incoming webhook, or anything that accepts a JSON
# body with a `text` field. Optional; leave unset to rely on the table alone.
# ERROR_WEBHOOK_URL=
