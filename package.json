{
  "name": "smart-edu",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "scripts": {
    "predev": "prisma generate && npm run v3:generate && npm run pdf:worker && npm run sw:build",
    "dev": "next dev",
    "prebuild": "prisma generate && npm run v3:generate && npm run pdf:worker && npm run sw:build",
    "pdf:worker": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "v3:generate": "prisma generate --config prisma/v3.config.ts",
    "v3:validate": "prisma validate --config prisma/v3.config.ts",
    "v3:db:push": "prisma db push --config prisma/v3.config.ts",
    "v3:pipeline": "python3 -m pdf_extraction.v3.cli",
    "v3:seed-fixture": "python3 scripts/v3-seed-fixture.py",
    "v3:verify-local": "node --experimental-strip-types scripts/v3-verify-local.mts",
    "test": "npm run test:node && npm run test:v3 && npm run test:personalization && npm run test:catalogue && npm run test:bank && npm run test:images",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "test:v3": "node --experimental-strip-types --test tests/v3-*.test.ts && python3 -m unittest discover -s tests/v3_pipeline -p 'test_*.py'",
    "test:bank": "python3 -m unittest discover -s tests/bank -p 'test_*.py'",
    "test:images": "python3 -m unittest discover -s tests/question_images -p 'test_*.py'",
    "test:personalization": "node --experimental-strip-types --test tests/course-resolution.test.mjs",
    "rag:index": "npx tsx scripts/reindex-rag.ts",
    "papers:index": "python3 scripts/index_paper_catalogue.py && npx tsx scripts/load-paper-catalogue.ts",
    "test:catalogue": "python3 -m unittest discover -s tests/catalogue -p 'test_*.py'",
    "sw:build": "node scripts/build-sw.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "storage:sync": "node --experimental-strip-types scripts/storage-sync.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tiptap/extension-color": "^3.26.1",
    "@tiptap/extension-highlight": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-text-style": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "bcrypt": "^6.0.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-pdf": "^10.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
