# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/generated/v3/

# Uploaded PDFs
public/uploads/

# V3 local corpus, extraction workspaces, manifests, and database files
/data/v3/assets/
/data/v3/work/
/data/v3/manifests/
/data/v3/sources/
/data/v3/postgres/
/data/v3/pglite/

# Past paper catalogue manifest (regenerate with npm run papers:index)
/data/paper-catalogue.json

# Copied from node_modules by npm run pdf:worker (runs on predev/prebuild)
/public/pdf.worker.min.mjs
/public/pdfjs/

# Generated from scripts/sw-template.js by npm run sw:build (predev/prebuild).
# Edit the template, never this file.
/public/sw.js

# ---------------------------------------------------------------------------
# Bulk assets. These live on disk during development but are never committed:
# they are large, and the paper corpus is copyright-sensitive. In production
# they are served from object storage, not from the repo.
# ---------------------------------------------------------------------------

# Raw past-paper PDFs and extraction workspace (~17 GB).
#
# The two packages below are the extraction pipeline itself — source, not
# assets — and were being ignored along with the corpus they sit next to. That
# left the only record of a fix in its tests. Everything else under here (the
# PDFs, the SQLite stores, the v2/v3 one-off scripts) stays out.
/pdf_extraction/*
!/pdf_extraction/bank/
!/pdf_extraction/question_images/
# The catalogue parser is 12 KB of source with a committed test suite that
# imports it; leaving it untracked meant tests/catalogue tested a file no
# checkout contained.
!/pdf_extraction/catalogue/
# CI installs this before running the Python suites, and `setup-python`'s pip
# cache resolves `**/requirements.txt` before any step runs. Ignoring it made
# every CI run fail in seventeen seconds, on every push, at the cache step --
# so the gate was red for reasons that had nothing to do with the commit.
!/pdf_extraction/requirements.txt
# `catalogue/parser.py` puts `pdf_extraction/` on sys.path and imports
# `lib.boards` from here, so the catalogue suite cannot even load without it.
# 252 KB of source across 13 files -- the same "source, not assets" case as
# the packages above.
!/pdf_extraction/lib/
/pdf_extraction/**/__pycache__/
__pycache__/
*.pyc
/pdf_extraction/**/*.db
/pdf_extraction/**/*.db-shm
/pdf_extraction/**/*.db-wal

# SQLite extraction database, superseded by Postgres (75 MB)
/papers.db
/papers.db-*

# Corpus exports / snapshots (~91 MB)
/backups/

# Generated question and step images (~730 MB total)
/data/question-images-v1/
/public/extracted_images/
/public/step-images/
# Question-bank crops, written here by the local storage driver.
/public/bank_assets/

# Local scrape cache (contains absolute paths from the dev machine)
/.download_cache.json

# Python virtualenv and pytest cache for the extraction pipeline
/.venv-bank/
/.pytest_cache/

# Pipeline evaluation fixtures
/gold-set/

# Generated Prisma clients and other build output
/generated/

# Stray screenshot
/IMG_9878.PNG

# Playwright
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/

# Extracted crop images: 400,328 files, 15.7 GB. They live in object storage
# (uploaded by scripts/upload-bank-assets.ts) and are rebuilt by the extraction
# pipeline, so they must never enter git history.
/pdf_extraction/bank/assets/
# Held by a running corpus_run so a second chunk cannot start; carries
# the holder's pid and is removed on exit. A stale one is recognised by
# its dead pid, so it is never a problem, but it is not repository state.
/pdf_extraction/bank/.corpus_run.lock

# Generated data migrations. Regenerate from pdf_extraction/bank/extract.db
# rather than carrying three-quarters of a megabyte of VALUES in git; the
# extractor that produces them is pdf_extraction/bank/marks.py.
prisma/manual/*.sql
!prisma/manual/*_verify_*.sql

# Supervisor runtime state, not source.
pdf_extraction/bank/transcription-status.txt
pdf_extraction/bank/transcription-launchd.log
pdf_extraction/bank/transcription-alerts.log

# runtime artefact of pdf_extraction/bank/run_transcription.sh
pdf_extraction/bank/.transcription.lock/

# Syllabus PDFs, fetched by scripts/fetch_syllabus_formats.py. 28MB of
# Cambridge's own documents, re-fetchable from the URLs in
# ops/syllabus/sources.json. The extracted text is committed instead, so a
# change to the parser can be reviewed without fetching anything.
/ops/syllabus/pdf/

# Runtime log of scripts/watch-tagging-then-answer-keys.sh, not source.
pdf_extraction/bank/answer-keys-watch.log

# Full-resolution artwork sources; the webp in public/ is what ships.
design/

# Local archives of removed features; the code lives in git tags.
backups/

# Worksheets generated by the local storage driver
/.exports/
